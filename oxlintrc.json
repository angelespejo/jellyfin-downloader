{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["recommended"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "no-control-regex": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".svelte-kit/**",
    "build/**",
    "data/**",
    ".dovenv/dev/fixtures/**"
  ]
}
