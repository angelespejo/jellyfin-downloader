JELLYFIN_SERVER=
JELLYFIN_API_KEY=

# Optional: empty means auto-detect
FFMPEG_PATH=
# Optional: extra ffmpeg candidate paths, separated by ':' (POSIX)
FFMPEG_CANDIDATES=
# Optional: auto, none, videotoolbox, nvenc, qsv or vaapi
FFMPEG_HWACCEL=auto
# Optional: VAAPI/QSV render device
FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128

# Reusable local downloads store
SERVER_LOCAL_DOWNLOADS_ENABLED=false
SERVER_LOCAL_DOWNLOADS_DIR=./data/downloads

# Optional; 0 = no limit / no expiry
SERVER_LOCAL_DOWNLOADS_MAX_GB=0
SERVER_LOCAL_DOWNLOADS_TTL_DAYS=0

# Global configuration editable from /settings
SERVER_SETTINGS_FILE=./data/settings.json

# Persistent job state (jobs are restored after a restart)
SERVER_JOBS_DIR=./data/jobs

# Persisted application logs
SERVER_LOGS_DIR=./data/logs
SERVER_LOGS_RETENTION_DAYS=14

# Optional: allowed CORS origins, comma-separated.
# Empty = same origin. '*' allows any origin (no authentication!).
API_CORS_ORIGINS=

# Optional: public URL when behind a proxy
# ORIGIN=http://localhost:3000
